=== FILE: app.dyno-proxy-static.toml ===
[accessLog]
  format = "common"
  [accessLog.fields]
    defaultMode = "drop"
    [accessLog.fields.headers]
      defaultMode = "drop"
      [accessLog.fields.headers.names]
        Host = "keep"
        X-Request-ID = "keep"
    [accessLog.fields.names]
      ClientUsername = "drop"
      Duration = "keep"
      RequestHeader = "drop"
      RequestHost = "keep"
      RequestMethod = "keep"
      RequestPath = "keep"
      RequestProtocol = "drop"
      RequestScheme = "drop"
      RequestURI = "keep"
      ResponseCode = "keep"
      ResponseSize = "keep"
      ServiceURL = "keep"

[entryPoints]
  [entryPoints.web]
    address = ":8888"
    [entryPoints.web.forwardedHeaders]
      trustedIPs = ["0.0.0.0/0"]

[global]
  checkNewVersion = false
  sendAnonymousUsage = false

[log]
  format = "common"
  level = "INFO"

[providers]
  [providers.file]
    filename = "<DIR>/app.dyno-proxy-dynamic.toml"
    watch = true
=== FILE: app.dyno-proxy-dynamic.toml ===
[http]
  [http.routers]
    [http.routers.app]
      rule = "PathPrefix(`/`)"
      service = "app"
      entryPoints = ["web"]
      priority = 1
    [http.routers.route-0]
      rule = "Path(`/api`)"
      service = "route-0"
      entryPoints = ["web"]
      priority = 10
    [http.routers.route-1]
      rule = "PathPrefix(`/path-prefix`)"
      service = "route-1"
      entryPoints = ["web"]
      priority = 10
    [http.routers.route-2]
      rule = "PathRegexp(`.*/wildcard.*`)"
      service = "route-2"
      entryPoints = ["web"]
      priority = 10
    [http.routers.route-3]
      rule = "Header(`x-custom-header`, `proxy-server`)"
      service = "route-3"
      entryPoints = ["web"]
      priority = 60
    [http.routers.route-4]
      rule = "QueryRegexp(`x-q`, `yo-.*`)"
      service = "route-4"
      entryPoints = ["web"]
      priority = 60
    [http.routers.route-5]
      rule = "Path(`/m`) && Method(`POST`)"
      service = "route-5"
      entryPoints = ["web"]
      priority = 10
  [http.services]
    [http.services.app]
      [http.services.app.loadBalancer]
        passHostHeader = true
        strategy = "p2c"

        [[http.services.app.loadBalancer.servers]]
          url = "http://localhost:5000"
    [http.services.route-0]
      [http.services.route-0.loadBalancer]
        passHostHeader = false
        strategy = "p2c"

        [[http.services.route-0.loadBalancer.servers]]
          url = "http://localhost:8080"
    [http.services.route-1]
      [http.services.route-1.loadBalancer]
        passHostHeader = false
        strategy = "p2c"

        [[http.services.route-1.loadBalancer.servers]]
          url = "http://localhost:8081"
    [http.services.route-2]
      [http.services.route-2.loadBalancer]
        passHostHeader = false
        strategy = "p2c"

        [[http.services.route-2.loadBalancer.servers]]
          url = "http://localhost:8082"
    [http.services.route-3]
      [http.services.route-3.loadBalancer]
        passHostHeader = false
        strategy = "p2c"

        [[http.services.route-3.loadBalancer.servers]]
          url = "http://localhost:8083"
    [http.services.route-4]
      [http.services.route-4.loadBalancer]
        passHostHeader = false
        strategy = "p2c"

        [[http.services.route-4.loadBalancer.servers]]
          url = "http://localhost:8084"
    [http.services.route-5]
      [http.services.route-5.loadBalancer]
        passHostHeader = false
        strategy = "p2c"

        [[http.services.route-5.loadBalancer.servers]]
          url = "http://localhost:8085"
